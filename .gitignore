# OS / OneDrive
desktop.ini
Thumbs.db
.DS_Store

# Editor
*.swp
*~

# Temporäre Screenshot-Reste
assets/img/demos$*.png

# Server-Daten: Datenbank, Schluessel, Startpasswort (niemals committen)
# Node-Fassung:
server/daten/
# PHP-Fassung: Inhalt ignorieren, aber die Schutz-.htaccess behalten
daten/*
!daten/.htaccess

# Hochgeladene Demo-HTML-Dateien: nicht committen, Schutz-.htaccess behalten
beispiel-demos/*
!beispiel-demos/.htaccess
# tavolo ist KEIN Upload, sondern fest ausgeliefert (Beispiel-Webapp)
!beispiel-demos/tavolo.html
# Branchen-Vorlagen: fest ausgeliefert (per scripts/vorlagen-sync gepflegt,
# NICHT per Admin hochgeladen). Slugs muessen zur $map in vorlagen-sync.ps1 passen.
!beispiel-demos/restaurant/
!beispiel-demos/reinigung/
!beispiel-demos/coiffeur/
!beispiel-demos/bauunternehmen/
!beispiel-demos/gartenbau/
!beispiel-demos/maler-gipser/
!beispiel-demos/autogarage/
!beispiel-demos/kosmetik/
!beispiel-demos/baeckerei/
!beispiel-demos/fahrschule/
!beispiel-demos/optik/
!beispiel-demos/metzgerei/
!beispiel-demos/praxis/

# Node
node_modules/

# Lokaler PHP-Test-Router (nur fuer php -S)
_devserver.php

# Claude Code: lokale Einstellungen
.claude/settings.local.json

# Graphify: lokal erzeugter Wissensgraph (Tooling, nicht Teil der Website)
graphify-out/

# claude-flow: lokaler Tool-Cache
.claude-flow/

# Python-Cache
__pycache__/
*.pyc
